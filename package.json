{
  "name": "open-configurator",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test:server": "tsx --test",
    "test:protocol": "tsx src/server/mavlink/MavlinkBridge.test.ts && tsx src/server/mavlink/MavlinkFtp.test.ts && tsx src/server/mavlink/MavlinkLogTransfer.test.ts && tsx src/shared/esc/crc.test.ts && tsx src/server/esc/EscSessionManager.test.ts && tsx src/server/esc/ArduPilotRawTransport.test.ts",
    "test:ftp": "tsx src/server/mavlink/MavlinkFtp.test.ts",
    "test:ulog": "tsx src/web/utils/ulogAnalysis.test.ts",
    "test:dataflash": "tsx src/web/utils/dataflashAnalysis.test.ts",
    "start": "tsx src/server/index.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "@foxglove/ulog": "^2.3.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mavlink-mappings": "^1.0.22-20260311",
    "node-mavlink": "^2.3.0",
    "serialport": "^13.0.0",
    "tsx": "^4.23.1",
    "uplot": "^1.6.32",
    "ws": "^8.21.1"
  },
  "overrides": {
    "xml2js": "^0.6.2"
  }
}
