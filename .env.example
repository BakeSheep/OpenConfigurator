# OpenConfigurator reads environment variables from the process. It does not load this
# file automatically. Use your shell or process manager to provide values.

# SKYLAB_* names are retained for compatibility with early releases.

HOST=127.0.0.1
PORT=3000

# Remote mode: keep disabled unless HTTPS/WSS and network controls are ready.
SKYLAB_ALLOW_REMOTE=false
# SKYLAB_AUTH_TOKEN=replace-with-at-least-32-random-printable-ascii-bytes
# SKYLAB_ALLOWED_ORIGINS=https://gcs.example.com
SKYLAB_WS_MAX_PAYLOAD=16384
SKYLAB_WS_MAX_CLIENTS=8

MAVLINK_PROTOCOL=auto
# MAVLINK_SIGNING_KEY=
MAVLINK_SIGNING_LINK_ID=0
MAVLINK_SIGNING_REQUIRE=false
